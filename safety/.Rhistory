p<-as.data.frame(md.pattern(raw[,!names(raw) %in% c("C000","CFA01","CFA02","CFA03","CFA04","CFS01","CFS02","CFS03","CFS04","Emp","EmpEnd","EmpS")]))
count<-as.numeric(str_remove(rownames(p),"X"))
p<-p*as.numeric(round(count,0))
p[is.na(p)]<-0
names(p)<-c(names(p)[1:ncol(p)-1],"100% complete vars")
ex<-as.data.frame(aggregate(data=p,.~GEOID,FUN="sum"))
ex<-ex[ex$GEOID!=0,]
ex<-data.frame(variable=rownames(t(ex)),complete.raw=t(ex)[,1])
ex$perc.raw.complete<-100*(1-(ex$complete.raw/length(unique(raw$GEOID))))
ex[ex$variable=="100% complete vars",]$perc.raw.complete<-100*(1-(ex[ex$variable=="100% complete vars",]$complete.raw/length(unique(raw$GEOID))))
ex<-ex[ex$perc.raw.complete<100,]
rownames(ex)<-NULL
ex$geo<-i
outs<-rbind(outs,ex)
}
