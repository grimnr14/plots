ifelse(
is.na(new$safety_rnk.y)&is.na(new$safety_rnk.x),"missing",
ifelse(
!is.na(new$safety_rnk.y)&!is.na(new$safety_rnk.x),"original",
ifelse(
is.na(new$safety_rnk.y)&!is.na(new$safety_rnk.x),"imputed",
NA
)
)
)
)
new$geoid<-paste0(new$sumlevel,"00US",new$GEOID)
new$safety_score<-round(new$safety_score.x,4)
new$safety_rnk<-round(new$safety_rnk.x,4)
new$safety_state_rnk<-round(new$safety_state_rnk.x,4)
new$crime_score<-round(new$crime_score.x,4)
new$infrastructure_score<-round(new$infrastructure_score.x,4)
new$social_cohesion_score<-round(new$social_cohesion_score.x,4)
new$structural_composition_score<-round(new$structural_composition_score.x,4)
out<-new[,c("geoid","geoname","geolevel","sumlevel","year","source","type",
"crime_score","infrastructure_score","social_cohesion_score","structural_composition_score",
"safety_score","safety_rnk","safety_state_rnk")]
write.table(out,paste0(output,"safety/combined safety index 2019-2023 full.csv"),sep=",",qmethod="double",row.names=F,col.names=T,append=T)
print(out[1,])
}
out<-read.csv(paste0(output,"safety/combined safety index 2019-2023 full.csv"),header=T)
out<-out[out$year %in% c(2020,2023)&out$geolevel %in% c("county","tract","zcta"),
c("geoid",
#"geoname",
"geolevel","year",
"crime_score","infrastructure_score","social_cohesion_score","structural_composition_score",
"safety_score","safety_rnk","safety_state_rnk")]
write.table(out,paste0(output,"safety/brief safety index 2019-2023 full.csv"),sep=",",qmethod="double",row.names=F,col.names=T)
