raw$year<-j
raw$geo<-i
outs<-rbind(outs,raw)
print(nrow(outs))
remove(raw)
gc()
}else{
if(i=="block group"){
raw<-pullACS(geography=i,variables=c("B01001_001","B25001_001","B26001_001","B19113_001"),state=state.abb,geometry=F,year=j,impute=T)
