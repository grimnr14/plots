ex<-dir(paste0(output,"economic/"))
ex<-ex[str_detect(ex,"rpart_")&str_detect(ex,"block group")==F]
for(i in ex){
imp<-read.csv(paste0(output,"economic/",i),header=T)
ori<-read.csv(paste0(output,"economic/economic_original_pca_",substr(i,str_locate(i,pattern="pca_")[2][[1]]+1,nchar(i))),header=T)
new<-merge(imp,ori,by=c("GEOID","NAME"),all.x=T)
charlim<-ifelse(str_detect(i,"county"),5,
ifelse(str_detect(i,"zcta")|str_detect(i,"zip code tabulation area"),5,
ifelse(str_detect(i,"tract"),11,
ifelse(str_detect(i,"block group"),12,NA))))
new$GEOID<-ifelse(nchar(new$GEOID)!=charlim,str_pad(new$GEOID,width=charlim,side="left",pad="0"),new$GEOID)
new$sumlevel<-ifelse(
nchar(new$GEOID)==5&str_detect(new$NAME,"ZCTA")==F,"050",
ifelse(
nchar(new$GEOID)==5&str_detect(new$NAME,"ZCTA")==T,"860",
ifelse(
nchar(new$GEOID)==11,"140",
ifelse(
nchar(new$GEOID)==12,"150",NA
)
)
)
)
new$source<-"ACS5"
new$year<-substr(i,nchar(i)-7,nchar(i)-4)
new$geolevel<-ifelse(
new$sumlevel=="050","county",
ifelse(new$sumlevel=="860","zcta",
ifelse(new$sumlevel=="140","tract",
ifelse(new$sumlevel=="150","bg",NA)))
)
new$geoname<-new$NAME
new$type<-ifelse(
is.na(new$economic_rnk.x)&(new$B01001_001.x<=100|new$B25001_001.x<=30|(new$B26001_001.x/new$B01001_001.x)<=0.333),"suppressed",
ifelse(
is.na(new$economic_rnk.y)&is.na(new$economic_rnk.x),"missing",
ifelse(
!is.na(new$economic_rnk.y)&!is.na(new$economic_rnk.x),"original",
ifelse(
is.na(new$economic_rnk.y)&!is.na(new$economic_rnk.x),"imputed",
NA
)
)
)
)
new$geoid<-paste0(new$sumlevel,"00US",new$GEOID)
new$economic_score<-round(new$economic_score.x,4)
new$economic_rnk<-round(new$economic_rnk.x,4)
new$economic_state_rnk<-round(new$economic_state_rnk.x,4)
new$income_score<-round(new$income_score.x,4)
new$affordability_score<-round(new$affordability_score.x,4)
new$wealth_score<-round(new$wealth_score.x,4)
new$equity_score<-round(new$equity_score.x,4)
out<-new[,c("geoid","geoname","geolevel","sumlevel","year","source","type",
"income_score","affordability_score","wealth_score","equity_score",
"economic_score","economic_rnk","economic_state_rnk")]
write.table(out,paste0(output,"economic/combined economic index 2020-2023 full.csv"),sep=",",qmethod="double",row.names=F,col.names=T,append=T)
print(out[1,])
}
out<-read.csv(paste0(output,"economic/combined economic index 2020-2023 full.csv"),header=T)
out<-out[out$year %in% c(2020,2023)&out$geolevel %in% c("county","tract","zcta"),
c("geoid",
#"geoname",
"geolevel","year",
"income_score","affordability_score","wealth_score","equity_score",
"economic_score","economic_rnk","economic_state_rnk")]
write.table(out,paste0(output,"economic/brief economic index 2020-2023 full.csv"),sep=",",qmethod="double",row.names=F,col.names=T)
setwd("C:/Users/chris/OneDrive/Desktop/GeoHealth/data/economic/plots/")
source("https://raw.githubusercontent.com/grimnr14/R-functions/refs/heads/main/flatMap.R")
library(stringr)
library(zippeR)
for(y in c(2020,2023)){
for(g in c("county",
"zcta",
"tract"
)){
for(l in c("economic_rnk","economic_state_rnk","economic_score")){
if(y==2019&g=="zcta"){
g<-"zip code tabulation area"
if(g=="zcta"|g=="zip code tabulation area"){
state.list<-NULL
}
}else{
state.list<-state.abb
}
d1<-read.csv(paste0("../economic_rpart_imputed_pca_",g,"_",y,".csv"),header=T)
d1$GEOID<-ifelse(nchar(d1$GEOID)!=5&g=="county",paste0("0",d1$GEOID),as.character(d1$GEOID))
d1$GEOID<-ifelse(nchar(d1$GEOID)!=5&(g=="zcta"|g=="zip code tabulation area"),str_pad(d1$GEOID,side="left",width=5,pad="0"),as.character(d1$GEOID))
d1$GEOID<-ifelse(nchar(d1$GEOID)!=11&g=="tract",paste0("0",d1$GEOID),as.character(d1$GEOID))
d1<-d1[!is.na(d1$economic_rnk),c("GEOID","NAME",l)]
for(s in state.list){
code<-fips_codes[fips_codes$state==s,]
zips<-zippeR::zi_list_zctas(year=y,state=code$state_code[1],method="intersect")
if(g=="county"){
png(paste0("economic_",s,"_",g,"_",y,"_",l,".png"),width=1600,height=1600)
print(flat_map(data=d1,#[d1$GEOID %in% paste0(code$state_code,code$county_code),],
year=ifelse(y<2020,2010,2020),
state=s,var=l,geography=ifelse(g=="zcta"|g=="zip code tabulation area","zcta5",g),geoid="GEOID",palette="RdBu",bin=8,type="flat"))
dev.off()
}
if(g=="zcta"|g=="zip code tabulation area"){
png(paste0("economic_",s,"_",g,"_",y,"_",l,".png"),width=1600,height=1600)
print(flat_map(data=d1,#[d1$GEOID %in% zips,],
year=ifelse(y<2020,2010,2020),
state=s,var=l,geography=ifelse(g=="zcta"|g=="zip code tabulation area","zcta5",g),geoid="GEOID",palette="RdBu",bin=8,type="flat"))
dev.off()
}
if(g=="tract"){
png(paste0("economic_",s,"_",g,"_",y,"_",l,".png"),width=1600,height=1600)
print(flat_map(data=d1,#[substr(d1$GEOID,1,5) %in% paste0(code$state_code,code$county_code),],
year=ifelse(y<2020,2010,2020),
state=s,var=l,geography=ifelse(g=="zcta"|g=="zip code tabulation area","zcta5",g),geoid="GEOID",palette="RdBu",bin=8,type="flat"))
dev.off()
}
}
}
}
}
