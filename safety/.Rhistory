raw$units<-ifelse(raw$B25001_001>30&!is.na(raw$B25001_001),1,0)
raw$group<-ifelse(raw$B26001_001/raw$B01001_001<0.333&!is.na(raw$B26001_001),1,0)
raw$year<-j
raw$geo<-i
